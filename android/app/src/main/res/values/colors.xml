<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget palettes. Both are always available so the widgets can follow the in-app theme
         instead of the system one; values-v31 swaps in the device's dynamic neutrals. -->
    <color name="widget_surface_light">#FFF7F8FC</color>
    <color name="widget_on_surface_light">#FF1B1C22</color>
    <color name="widget_on_surface_variant_light">#FF5B5E6E</color>
    <color name="widget_on_surface_dim_light">#FF9C9FAD</color>
    <color name="widget_track_light">#FFE1E2EC</color>

    <color name="widget_surface_dark">#FF1B1C21</color>
    <color name="widget_on_surface_dark">#FFE4E4EC</color>
    <color name="widget_on_surface_variant_dark">#FFB2B4C2</color>
    <color name="widget_on_surface_dim_dark">#FF6F7282</color>
    <color name="widget_track_dark">#FF33343D</color>

    <color name="widget_accent">#FF4F5BD5</color>
    <color name="widget_chip">#1F8A8FA8</color>

    <!-- Day/night aliases used directly by layouts (initial and preview layouts). -->
    <color name="widget_surface">@color/widget_surface_light</color>
    <color name="widget_on_surface">@color/widget_on_surface_light</color>
    <color name="widget_on_surface_variant">@color/widget_on_surface_variant_light</color>
    <color name="widget_on_surface_dim">@color/widget_on_surface_dim_light</color>
    <color name="widget_track">@color/widget_track_light</color>
</resources>
